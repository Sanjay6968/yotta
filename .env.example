# ChronoLedger — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# PostgreSQL connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chronoledger
DB_USER=chronoledger_user
DB_PASSWORD=changeme

# Pipeline settings
LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR
PIPELINE_SCHEMA=public  # PostgreSQL schema to use
